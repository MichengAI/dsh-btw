{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types"
  },
  "include": ["src", "tests"]
}
